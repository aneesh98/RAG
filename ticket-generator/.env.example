# Development-only defaults. Copy to .env in this directory if overriding.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
# If credentials above change, update this connection URL too.
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@db:5432/helpdesk
CORS_ORIGINS=http://localhost:5173
DEMO_AUTH_ENABLED=true
BACKEND_PORT=8001
FRONTEND_PORT=5173
# Browser-visible URL, not the Docker service hostname.
VITE_API_BASE_URL=http://localhost:8001
